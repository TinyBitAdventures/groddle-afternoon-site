{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": false,
    "color": { "defaultPalette": false, "defaultGradients": false, "defaultDuotone": false },
    "typography": { "defaultFontSizes": false },
    "spacing": { "defaultSpacingSizes": false },
    "layout": { "contentSize": "1040px", "wideSize": "1180px" }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-wide", "title": "Full-width page", "postTypes": ["page"] }
  ]
}
