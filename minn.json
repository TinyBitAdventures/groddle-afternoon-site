{
  "name": "Groddle Afternoon",
  "version": "0.5.5",
  "license": "MIT",
  "autoload": {
    "Groddle\\Minn\\": "src/"
  },
  "extension": "Groddle\\Minn\\Extension",
  "blocks": [
    "groddle/stamp",
    "groddle/features",
    "groddle/feature",
    "groddle/milestones",
    "groddle/milestone",
    "groddle/ledger",
    "groddle/figure",
    "groddle/quests",
    "groddle/quest",
    "groddle/signpost",
    "groddle/sign",
    "groddle/restoration-score",
    "groddle/restoration-street",
    "groddle/restoration-systems",
    "groddle/restoration-numbers",
    "groddle/restoration-rooms",
    "groddle/restoration-designers",
    "groddle/restoration-levels",
    "groddle/restoration-recent",
    "groddle/restoration-lost",
    "groddle/restoration-legend",
    "groddle/restoration-stamp",
    "groddle/restoration-seasons",
    "groddle/musicblocks",
    "groddle/musicblocks-rules",
    "groddle/street-music",
    "groddle/site-nav"
  ],
  "tables": {
    "groddle_groups": [
      "id bigint(20) unsigned NOT NULL AUTO_INCREMENT",
      "name varchar(32) NOT NULL",
      "name_key varchar(32) NOT NULL",
      "description varchar(300) NOT NULL DEFAULT ''",
      "mode varchar(8) NOT NULL DEFAULT 'public'",
      "created_by bigint(20) unsigned NOT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (id)",
      "UNIQUE KEY name_key (name_key)",
      "KEY mode (mode)"
    ],
    "groddle_group_members": [
      "group_id bigint(20) unsigned NOT NULL",
      "user_id bigint(20) unsigned NOT NULL",
      "role varchar(8) NOT NULL DEFAULT 'member'",
      "joined_at datetime NOT NULL",
      "PRIMARY KEY  (group_id,user_id)",
      "KEY user_id (user_id)"
    ],
    "groddle_group_invites": [
      "group_id bigint(20) unsigned NOT NULL",
      "user_id bigint(20) unsigned NOT NULL",
      "invited_by bigint(20) unsigned NOT NULL",
      "invited_at datetime NOT NULL",
      "PRIMARY KEY  (group_id,user_id)",
      "KEY user_id (user_id)"
    ],
    "groddle_ledger": [
      "user_id bigint(20) unsigned NOT NULL",
      "currants bigint(20) unsigned NOT NULL DEFAULT 0",
      "budget double NOT NULL DEFAULT 0",
      "budget_at bigint(20) unsigned NOT NULL DEFAULT 0",
      "seeded varchar(16) NOT NULL DEFAULT ''",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_ledger_items": [
      "user_id bigint(20) unsigned NOT NULL",
      "class_tsid varchar(64) NOT NULL",
      "count int(10) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,class_tsid)"
    ],
    "groddle_trades": [
      "trade_id varchar(40) NOT NULL",
      "status varchar(8) NOT NULL",
      "a_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "b_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "a_gave text NOT NULL",
      "b_gave text NOT NULL",
      "a_applied_at datetime NULL DEFAULT NULL",
      "b_applied_at datetime NULL DEFAULT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (trade_id)",
      "KEY a_id (a_id)",
      "KEY b_id (b_id)"
    ],
    "groddle_ledger_log": [
      "id bigint(20) unsigned NOT NULL AUTO_INCREMENT",
      "user_id bigint(20) unsigned NOT NULL",
      "at datetime NOT NULL",
      "kind varchar(16) NOT NULL",
      "detail text NOT NULL",
      "PRIMARY KEY  (id)",
      "KEY user_at (user_id,at)"
    ],
    "groddle_ledger_credited": [
      "user_id bigint(20) unsigned NOT NULL",
      "kind varchar(8) NOT NULL",
      "ref varchar(96) NOT NULL",
      "n int(10) unsigned NOT NULL DEFAULT 0",
      "at datetime NOT NULL",
      "PRIMARY KEY  (user_id,kind,ref)"
    ],
    "groddle_house_keys": [
      "owner_id bigint(20) unsigned NOT NULL",
      "holder_id bigint(20) unsigned NOT NULL",
      "granted_at datetime NOT NULL",
      "PRIMARY KEY  (owner_id,holder_id)",
      "KEY holder_id (holder_id)"
    ],
    "groddle_home_visitors": [
      "user_id bigint(20) unsigned NOT NULL",
      "opted_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_mp_saves": [
      "user_id bigint(20) unsigned NOT NULL",
      "data longtext NOT NULL",
      "version bigint(20) unsigned NOT NULL DEFAULT 0",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_players": [
      "user_id bigint(20) unsigned NOT NULL",
      "name varchar(32) NOT NULL",
      "name_key varchar(32) NOT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)",
      "UNIQUE KEY name_key (name_key)"
    ],
    "groddle_buddies": [
      "user_id bigint(20) unsigned NOT NULL",
      "buddy_id bigint(20) unsigned NOT NULL",
      "group_name varchar(32) NOT NULL DEFAULT 'Buddies'",
      "added_at datetime NOT NULL",
      "noticed tinyint(1) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,buddy_id)",
      "KEY buddy_id (buddy_id)"
    ],
    "groddle_ignores": [
      "user_id bigint(20) unsigned NOT NULL",
      "ignored_id bigint(20) unsigned NOT NULL",
      "added_at datetime NOT NULL",
      "PRIMARY KEY  (user_id,ignored_id)",
      "KEY ignored_id (ignored_id)"
    ],
    "groddle_profiles": [
      "user_id bigint(20) unsigned NOT NULL",
      "about varchar(500) NOT NULL DEFAULT ''",
      "avatar mediumblob NULL",
      "tile mediumblob NULL",
      "avatar_key varchar(64) NOT NULL DEFAULT ''",
      "avatar_at datetime NULL",
      "home mediumblob NULL",
      "home_key varchar(64) NOT NULL DEFAULT ''",
      "home_at datetime NULL",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_solo_backups": [
      "user_id bigint(20) unsigned NOT NULL",
      "slot tinyint(3) unsigned NOT NULL",
      "data longtext NOT NULL",
      "made_at datetime NOT NULL",
      "game_day varchar(64) NOT NULL DEFAULT ''",
      "size int(10) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,slot)"
    ]
  }
}
