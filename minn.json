{
  "name": "Groddle Afternoon",
  "version": "0.5.16",
  "license": "MIT",
  "autoload": {
    "Groddle\\Minn\\": "src/"
  },
  "extension": "Groddle\\Minn\\Extension",
  "blocks": [
    "groddle/stamp",
    "groddle/features",
    "groddle/feature",
    "groddle/milestones",
    "groddle/milestone",
    "groddle/ledger",
    "groddle/figure",
    "groddle/quests",
    "groddle/quest",
    "groddle/signpost",
    "groddle/sign",
    "groddle/restoration-score",
    "groddle/restoration-street",
    "groddle/restoration-systems",
    "groddle/restoration-numbers",
    "groddle/restoration-rooms",
    "groddle/restoration-designers",
    "groddle/restoration-levels",
    "groddle/restoration-recent",
    "groddle/restoration-lost",
    "groddle/restoration-legend",
    "groddle/restoration-stamp",
    "groddle/restoration-seasons",
    "groddle/musicblocks",
    "groddle/musicblocks-rules",
    "groddle/street-music",
    "groddle/codebase",
    "groddle/site-nav"
  ],
  "types": [
    {
      "slug": "groddle_feedback",
      "name": "Bug reports",
      "singular": "Bug report",
      "rest_base": "bug-reports",
      "hierarchical": false,
      "supports": ["title", "editor", "author", "custom-fields"],
      "description": "Bug reports players sent from the game's header.",
      "icon": "dashicons-flag"
    }
  ],
  "tables": {
    "groddle_groups": [
      "id bigint(20) unsigned NOT NULL AUTO_INCREMENT",
      "name varchar(32) NOT NULL",
      "name_key varchar(32) NOT NULL",
      "description varchar(300) NOT NULL DEFAULT ''",
      "mode varchar(8) NOT NULL DEFAULT 'public'",
      "created_by bigint(20) unsigned NOT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (id)",
      "UNIQUE KEY name_key (name_key)",
      "KEY mode (mode)"
    ],
    "groddle_group_members": [
      "group_id bigint(20) unsigned NOT NULL",
      "user_id bigint(20) unsigned NOT NULL",
      "role varchar(8) NOT NULL DEFAULT 'member'",
      "joined_at datetime NOT NULL",
      "PRIMARY KEY  (group_id,user_id)",
      "KEY user_id (user_id)"
    ],
    "groddle_group_invites": [
      "group_id bigint(20) unsigned NOT NULL",
      "user_id bigint(20) unsigned NOT NULL",
      "invited_by bigint(20) unsigned NOT NULL",
      "invited_at datetime NOT NULL",
      "PRIMARY KEY  (group_id,user_id)",
      "KEY user_id (user_id)"
    ],
    "groddle_ledger": [
      "user_id bigint(20) unsigned NOT NULL",
      "currants bigint(20) unsigned NOT NULL DEFAULT 0",
      "budget double NOT NULL DEFAULT 0",
      "budget_at bigint(20) unsigned NOT NULL DEFAULT 0",
      "seeded varchar(16) NOT NULL DEFAULT ''",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_ledger_items": [
      "user_id bigint(20) unsigned NOT NULL",
      "class_tsid varchar(64) NOT NULL",
      "count int(10) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,class_tsid)"
    ],
    "groddle_trades": [
      "trade_id varchar(40) NOT NULL",
      "status varchar(8) NOT NULL",
      "a_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "b_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "a_gave text NOT NULL",
      "b_gave text NOT NULL",
      "a_applied_at datetime NULL DEFAULT NULL",
      "b_applied_at datetime NULL DEFAULT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (trade_id)",
      "KEY a_id (a_id)",
      "KEY b_id (b_id)"
    ],
    "groddle_ledger_log": [
      "id bigint(20) unsigned NOT NULL AUTO_INCREMENT",
      "user_id bigint(20) unsigned NOT NULL",
      "at datetime NOT NULL",
      "kind varchar(16) NOT NULL",
      "detail text NOT NULL",
      "PRIMARY KEY  (id)",
      "KEY user_at (user_id,at)"
    ],
    "groddle_ledger_credited": [
      "user_id bigint(20) unsigned NOT NULL",
      "kind varchar(8) NOT NULL",
      "ref varchar(96) NOT NULL",
      "n int(10) unsigned NOT NULL DEFAULT 0",
      "at datetime NOT NULL",
      "PRIMARY KEY  (user_id,kind,ref)"
    ],
    "groddle_ledger_outcomes": [
      "event_id varchar(40) NOT NULL",
      "user_id bigint(20) unsigned NOT NULL",
      "why varchar(8) NOT NULL",
      "got text NOT NULL",
      "unused text NOT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (event_id)",
      "KEY user_id (user_id,created_at)"
    ],
    "groddle_house_keys": [
      "owner_id bigint(20) unsigned NOT NULL",
      "holder_id bigint(20) unsigned NOT NULL",
      "granted_at datetime NOT NULL",
      "PRIMARY KEY  (owner_id,holder_id)",
      "KEY holder_id (holder_id)"
    ],
    "groddle_butler_parcels": [
      "id varchar(40) NOT NULL",
      "owner_id bigint(20) unsigned NOT NULL",
      "from_id bigint(20) unsigned NOT NULL",
      "class_tsid varchar(64) NOT NULL DEFAULT ''",
      "count int(10) unsigned NOT NULL DEFAULT 0",
      "message varchar(500) NOT NULL DEFAULT ''",
      "at_ms bigint(20) unsigned NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "taken_at datetime NULL DEFAULT NULL",
      "PRIMARY KEY  (id)",
      "KEY owner_id (owner_id,taken_at)",
      "KEY from_id (from_id)"
    ],
    "groddle_auctions": [
      "id varchar(16) NOT NULL",
      "seller_id bigint(20) unsigned NOT NULL",
      "class_tsid varchar(64) NOT NULL",
      "count int(10) unsigned NOT NULL",
      "cost bigint(20) unsigned NOT NULL",
      "fee int(10) unsigned NOT NULL DEFAULT 0",
      "r int(10) unsigned NULL DEFAULT NULL",
      "status varchar(10) NOT NULL DEFAULT 'active'",
      "buyer_id bigint(20) unsigned NULL DEFAULT NULL",
      "proceeds bigint(20) unsigned NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "expires_at datetime NOT NULL",
      "ended_at datetime NULL DEFAULT NULL",
      "deliver_to bigint(20) unsigned NULL DEFAULT NULL",
      "deliver_at datetime NULL DEFAULT NULL",
      "collected_at datetime NULL DEFAULT NULL",
      "PRIMARY KEY  (id)",
      "KEY browse (status,class_tsid)",
      "KEY seller_id (seller_id,status)",
      "KEY buyer_id (buyer_id)",
      "KEY deliver_to (deliver_to,collected_at)"
    ],
    "groddle_gifts": [
      "id varchar(40) NOT NULL",
      "from_id bigint(20) unsigned NOT NULL",
      "to_id bigint(20) unsigned NOT NULL",
      "goods text NOT NULL",
      "box tinyint(1) unsigned NOT NULL DEFAULT 0",
      "ref varchar(40) NOT NULL DEFAULT ''",
      "note_title varchar(200) NULL DEFAULT NULL",
      "note_body text NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (id)",
      "KEY from_id (from_id)",
      "KEY to_id (to_id)"
    ],
    "groddle_group_halls": [
      "claim_id varchar(40) NOT NULL",
      "job_id varchar(16) NOT NULL",
      "group_id bigint(20) unsigned NOT NULL",
      "claimer_id bigint(20) unsigned NOT NULL",
      "currants int(10) unsigned NOT NULL DEFAULT 0",
      "status varchar(8) NOT NULL",
      "claimed_at datetime NOT NULL",
      "built_at datetime NULL DEFAULT NULL",
      "PRIMARY KEY  (claim_id)",
      "KEY group_id (group_id)",
      "KEY claimer_id (claimer_id)"
    ],
    "groddle_drops": [
      "id varchar(40) NOT NULL",
      "dropper_id bigint(20) unsigned NOT NULL",
      "street varchar(32) NOT NULL",
      "x int(11) NOT NULL DEFAULT 0",
      "y int(11) NOT NULL DEFAULT 0",
      "class_tsid varchar(64) NOT NULL",
      "count int(10) unsigned NOT NULL",
      "points int(10) unsigned NULL DEFAULT NULL",
      "status varchar(8) NOT NULL",
      "taker_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "why varchar(8) NOT NULL DEFAULT ''",
      "created_at datetime NOT NULL",
      "taken_at datetime NULL DEFAULT NULL",
      "PRIMARY KEY  (id)",
      "KEY status (status)",
      "KEY dropper_id (dropper_id)",
      "KEY taker_id (taker_id)"
    ],
    "groddle_home_signposts": [
      "owner_id bigint(20) unsigned NOT NULL",
      "position tinyint(3) unsigned NOT NULL",
      "neighbor_id bigint(20) unsigned NOT NULL",
      "added_at datetime NOT NULL",
      "PRIMARY KEY  (owner_id,position)",
      "KEY neighbor_id (neighbor_id)"
    ],
    "groddle_furniture_sales": [
      "id varchar(40) NOT NULL",
      "owner_id bigint(20) unsigned NOT NULL",
      "uid int(10) unsigned NOT NULL",
      "class_tsid varchar(64) NOT NULL",
      "price int(10) unsigned NOT NULL",
      "status varchar(10) NOT NULL",
      "buyer_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "x int(11) NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "updated_at datetime NOT NULL",
      "sold_at datetime NULL DEFAULT NULL",
      "collected_at datetime NULL DEFAULT NULL",
      "PRIMARY KEY  (id)",
      "KEY owner_id (owner_id,status)",
      "KEY buyer_id (buyer_id)"
    ],
    "groddle_home_tending": [
      "id varchar(40) NOT NULL",
      "owner_id bigint(20) unsigned NOT NULL",
      "visitor_id bigint(20) unsigned NOT NULL",
      "yard varchar(8) NOT NULL DEFAULT 'street'",
      "garden varchar(80) NOT NULL",
      "plot varchar(8) NOT NULL",
      "act varchar(8) NOT NULL",
      "seed varchar(64) NOT NULL DEFAULT ''",
      "at_ms bigint(20) unsigned NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (id)",
      "KEY owner_id (owner_id,at_ms)",
      "KEY visitor_id (visitor_id)"
    ],
    "groddle_home_pool": [
      "owner_id bigint(20) unsigned NOT NULL",
      "day int(11) NOT NULL",
      "amount int(11) NOT NULL DEFAULT 0",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (owner_id,day)"
    ],
    "groddle_home_pool_marks": [
      "owner_id bigint(20) unsigned NOT NULL",
      "visitor_id bigint(20) unsigned NOT NULL",
      "day int(11) NOT NULL",
      "mark varchar(40) NOT NULL",
      "amount int(11) NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (owner_id,visitor_id,day,mark)",
      "KEY visitor_id (visitor_id)"
    ],
    "groddle_home_visitors": [
      "user_id bigint(20) unsigned NOT NULL",
      "opted_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_mp_saves": [
      "user_id bigint(20) unsigned NOT NULL",
      "data longtext NOT NULL",
      "version bigint(20) unsigned NOT NULL DEFAULT 0",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_players": [
      "user_id bigint(20) unsigned NOT NULL",
      "name varchar(32) NOT NULL",
      "name_key varchar(32) NOT NULL",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)",
      "UNIQUE KEY name_key (name_key)"
    ],
    "groddle_signups": [
      "token_hash char(64) NOT NULL",
      "email varchar(100) NOT NULL",
      "email_key varchar(100) NOT NULL",
      "pass_hash varchar(255) NOT NULL DEFAULT ''",
      "name varchar(32) NOT NULL",
      "name_key varchar(32) NOT NULL",
      "sends tinyint(3) unsigned NOT NULL DEFAULT 0",
      "sent_at datetime NOT NULL",
      "created_at datetime NOT NULL",
      "expires_at datetime NOT NULL",
      "used_at datetime NULL DEFAULT NULL",
      "user_id bigint(20) unsigned NOT NULL DEFAULT 0",
      "ip varchar(45) NOT NULL DEFAULT ''",
      "PRIMARY KEY  (token_hash)",
      "UNIQUE KEY email_key (email_key)",
      "KEY name_key (name_key)",
      "KEY created_ip (ip,created_at)"
    ],
    "groddle_buddies": [
      "user_id bigint(20) unsigned NOT NULL",
      "buddy_id bigint(20) unsigned NOT NULL",
      "group_name varchar(32) NOT NULL DEFAULT 'Buddies'",
      "added_at datetime NOT NULL",
      "noticed tinyint(1) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,buddy_id)",
      "KEY buddy_id (buddy_id)"
    ],
    "groddle_ignores": [
      "user_id bigint(20) unsigned NOT NULL",
      "ignored_id bigint(20) unsigned NOT NULL",
      "added_at datetime NOT NULL",
      "PRIMARY KEY  (user_id,ignored_id)",
      "KEY ignored_id (ignored_id)"
    ],
    "groddle_profiles": [
      "user_id bigint(20) unsigned NOT NULL",
      "about varchar(500) NOT NULL DEFAULT ''",
      "avatar mediumblob NULL",
      "tile mediumblob NULL",
      "avatar_key varchar(64) NOT NULL DEFAULT ''",
      "avatar_at datetime NULL",
      "home mediumblob NULL",
      "home_key varchar(64) NOT NULL DEFAULT ''",
      "home_at datetime NULL",
      "updated_at datetime NOT NULL",
      "PRIMARY KEY  (user_id)"
    ],
    "groddle_snaps": [
      "id bigint(20) unsigned NOT NULL AUTO_INCREMENT",
      "user_id bigint(20) unsigned NOT NULL",
      "file varchar(40) NOT NULL",
      "street varchar(32) NOT NULL DEFAULT ''",
      "x int(11) NOT NULL DEFAULT 0",
      "y int(11) NOT NULL DEFAULT 0",
      "caption varchar(500) NOT NULL DEFAULT ''",
      "width smallint(5) unsigned NOT NULL DEFAULT 0",
      "height smallint(5) unsigned NOT NULL DEFAULT 0",
      "bytes int(10) unsigned NOT NULL DEFAULT 0",
      "created_at datetime NOT NULL",
      "PRIMARY KEY  (id)",
      "KEY user_id (user_id,created_at)",
      "KEY street (street)"
    ],
    "groddle_solo_backups": [
      "user_id bigint(20) unsigned NOT NULL",
      "slot tinyint(3) unsigned NOT NULL",
      "data longtext NOT NULL",
      "made_at datetime NOT NULL",
      "game_day varchar(64) NOT NULL DEFAULT ''",
      "size int(10) unsigned NOT NULL DEFAULT 0",
      "PRIMARY KEY  (user_id,slot)"
    ]
  }
}
