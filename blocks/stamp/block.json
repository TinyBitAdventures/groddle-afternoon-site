{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "groddle/stamp",
	"title": "Stamp",
	"category": "text",
	"description": "A big figure with a line under it, beside a note's opening.",
	"attributes": {
		"value": {
			"type": "string",
			"default": "0"
		},
		"caption": {
			"type": "string",
			"default": "what the figure counts"
		}
	},
	"supports": {
		"html": false,
		"className": false,
		"customClassName": false
	},
	"textdomain": "groddle"
}
